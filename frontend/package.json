{
  "name": "frontend",
  "version": "0.1.1",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "serve": "^14.2.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:prod": "set GENERATE_SOURCEMAP=false && react-scripts build",
    "build:prod-unix": "GENERATE_SOURCEMAP=false react-scripts build",
    "eject": "react-scripts eject",
    "serve": "serve -s build -p 3000",
    "build-and-serve": "npm run build:prod && npm run serve"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "ie 11",
      "chrome >= 60",
      "firefox >= 60",
      "safari >= 10"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
